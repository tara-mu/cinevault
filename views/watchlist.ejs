<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Watchlist - CineVault</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav>
        <a href="/">Home</a>
        <a href="/movies/search">Search Movies</a>
        <a href="/watchlist">My Watchlist</a>
    </nav>

    <div class="container">
        <h1>📋 My Watchlist</h1>

        <% if (message) { %>
            <p class="status-msg"><%= message %></p>
        <% } %>

        <% if (items.length === 0) { %>
            <div class="empty-state">
                <p>Your watchlist is empty.</p>
                <a href="/movies/search" class="btn">Search for Movies</a>
            </div>
        <% } else { %>
            <p class="count"><%= items.length %> movie<%= items.length !== 1 ? 's' : '' %> in your watchlist</p>

            <div class="results-grid">
                <% items.forEach(function(item) { %>
                    <div class="movie-card">
                        <% if (item.posterUrl) { %>
                            <img
                                src="<%= item.posterUrl %>"
                                alt="<%= item.title %>"
                                class="poster"
                                onerror="this.style.display='none'"
                            />
                        <% } else { %>
                            <div class="no-poster">No Image</div>
                        <% } %>

                        <div class="movie-info">
                            <h3><%= item.title %></h3>
                            <p><strong>Year:</strong> <%= item.year %></p>
                            <p><strong>Rating:</strong> <%= item.rating %></p>
                            <p><strong>Genre:</strong> <%= item.genres %></p>
                            <% if (item.userNote) { %>
                                <p><strong>Note:</strong> <em><%= item.userNote %></em></p>
                            <% } %>
                            <p class="added-date"><strong>Added:</strong> <%= item.addedOn.toLocaleDateString() %></p>

                            <form action="/watchlist/remove" method="POST">
                                <input type="hidden" name="imdbId" value="<%= item.imdbId %>"/>
                                <button type="submit" class="btn btn-danger btn-small">Remove</button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <footer>
        <p>CineVault &mdash; Powered by IMDB236 API</p>
    </footer>
</body>
</html>
