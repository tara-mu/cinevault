<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CineVault</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav>
        <a href="/">Home</a>
        <a href="/movies/search">Search Movies</a>
        <a href="/watchlist">My Watchlist</a>
    </nav>

    <div class="hero">
        <h1>🎬 CineVault</h1>
        <p class="subtitle">Search millions of movies and build your personal watchlist.</p>

        <div class="home-cards">
            <div class="card">
                <h2>🔍 Search Movies</h2>
                <p>Find any movie using the IMDB database and see its rating, genre, and more.</p>
                <a href="/movies/search" class="btn">Start Searching</a>
            </div>
            <div class="card">
                <h2>📋 My Watchlist</h2>
                <p>View all movies you have saved and manage your personal collection.</p>
                <a href="/watchlist" class="btn">View Watchlist</a>
            </div>
        </div>
    </div>

    <footer>
        <p>CineVault &mdash; Powered by IMDB236 API</p>
    </footer>
</body>
</html>
